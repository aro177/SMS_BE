# Public/non-sensitive runtime configuration only.
# API_DOMAIN must be a real DNS name without http://, https://, a path, or a port.
API_DOMAIN=api.example.com

# Comma-separated browser frontend origins. Do not add a trailing slash.
CORS_ALLOWED_ORIGINS=https://app.example.com

SUPABASE_URL=https://your-project.supabase.co
AUTHENTICATION_VALID_ISSUER=https://your-project.supabase.co/auth/v1
AUTHENTICATION_VALID_AUDIENCE=authenticated
