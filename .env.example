# Folder containing the frontend Dockerfile, relative to this compose project
# or as an absolute path. Recommended layout: ../sms-frontend
FRONTEND_BUILD_CONTEXT=../sms-frontend

# One public hostname for the frontend. Do not include a scheme, path, or port.
PUBLIC_DOMAIN=sms.example.com

# Public Supabase browser configuration used while building the Next.js bundle.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
TURNSTILE_SITE_KEY=your-public-turnstile-site-key
SUPABASE_AUTH_COOKIE_NAME=

AUTHENTICATION_VALID_ISSUER=https://your-project.supabase.co/auth/v1
AUTHENTICATION_VALID_AUDIENCE=authenticated

# Optional host port for PostgreSQL local when using docker-compose.local-db.yml.
LOCAL_POSTGRES_PORT=5433
